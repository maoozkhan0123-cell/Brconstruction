{
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node"] },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "data/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.mts",
    "db/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules", "dist", ".vinext", ".wrangler", ".sites-runtime",
    ".qa", "outputs", "work", "examples", "worker", "scripts",
    "db/cloudflare.ts", "lib/inquiry-runtime.cloudflare.ts"
  ]
}
