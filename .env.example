# BR Construction — optional environment configuration.
# Put the server-only variables below in .dev.vars for local Worker development.
# For production runtime secrets, use Sites environment settings.
# Never expose server secrets through NEXT_PUBLIC_* or commit populated env files.

# Recommended: a long randomly generated value for keyed rate-limit identifiers.
INQUIRY_RATE_LIMIT_SECRET=

# Optional: your approved HTTPS endpoint for email notifications or CRM intake.
# An accepted inquiry is saved in D1 even when this is unset or the webhook fails.
INQUIRY_NOTIFICATION_WEBHOOK=

# Optional: bearer token supplied to the HTTPS notification endpoint.
INQUIRY_NOTIFICATION_TOKEN=

# PUBLIC BUILD-TIME VALUE: put this line in .env.local before building.
# Only a licensed or company-approved HTTPS video URL; never include a secret.
# Leave unset for the default poster. Rebuild after changing it.
# NEXT_PUBLIC_HERO_VIDEO_URL=
