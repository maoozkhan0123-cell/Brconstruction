# Copy to ignored .env.local for local Next.js development and migrations.
# Configure hosted values in Vercel project settings, then redeploy.
# Never commit populated environment files or expose secrets through NEXT_PUBLIC_*.

# Required to save inquiries in a hosted Turso/libSQL database.
# LIBSQL_DATABASE_URL and LIBSQL_AUTH_TOKEN are accepted aliases.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Recommended: a long randomly generated server-only rate-limit secret.
INQUIRY_RATE_LIMIT_SECRET=

# Optional: approved HTTPS endpoint for email notifications or CRM intake.
# A saved inquiry remains in the database if this is unset or delivery fails.
INQUIRY_NOTIFICATION_WEBHOOK=

# Optional: bearer token supplied only to the notification endpoint.
INQUIRY_NOTIFICATION_TOKEN=

# Optional PUBLIC BUILD-TIME values. Never include access tokens or secrets.
# Defaults to Vercel's project/deployment origin, or http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain.example
# Licensed/company-approved HTTPS video only. Leave unset for the default poster.
# NEXT_PUBLIC_HERO_VIDEO_URL=

# Optional Sites/Cloudflare development uses .dev.vars for server-only inquiry
# secrets and the DB D1 binding. It does not use the Turso variables above.
